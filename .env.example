# ============================================================================
# MyB — environment variables (master reference)
# ----------------------------------------------------------------------------
# Copy the per-surface examples instead of this file:
#   app/.env.example         → app/.env          (Expo public vars only)
#   ai-service/.env.example  → ai-service/.env   (server-side secrets)
# Edge function secrets are set with `supabase secrets set` (see SETUP.md §4).
#
# NEVER commit a real .env file. NEVER put the service-role key or LLM keys
# in app/.env — anything prefixed EXPO_PUBLIC_ ships inside the client bundle.
# ============================================================================

# --- Supabase (create a project at https://supabase.com/dashboard) ----------
# Project Settings → Data API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Project Settings → API Keys → anon/publishable key (safe for the client; RLS enforces access)
SUPABASE_ANON_KEY=REPLACE_ME
# Project Settings → API Keys → service_role/secret key (SERVER-SIDE ONLY: ai-service + edge functions)
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# --- LLM providers ----------------------------------------------------------
# Primary: Google AI Studio → https://aistudio.google.com/apikey (free tier)
GEMINI_API_KEY=REPLACE_ME
# Failover: Groq → https://console.groq.com/keys (free tier)
GROQ_API_KEY=REPLACE_ME

# --- AI service (FastAPI) ---------------------------------------------------
# Local dev: http://localhost:8000 — deployed: your Render/HF Spaces/Cloud Run URL.
# No shared API key: the app authenticates to the AI service with the user's
# Supabase access token, which the service verifies against Supabase Auth.
AI_SERVICE_URL=http://localhost:8000
