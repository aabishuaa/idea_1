# MyB app — copy to .env and fill in (SETUP.md §3 and §7).
# EVERYTHING here ships in the client bundle (EXPO_PUBLIC_*): anon key only —
# never the service-role key, never LLM keys (SR-13).

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME

# Local dev: http://localhost:8000 (use your LAN IP for a physical device,
# e.g. http://192.168.1.20:8000). Deployed: your Render URL.
EXPO_PUBLIC_AI_SERVICE_URL=http://localhost:8000
