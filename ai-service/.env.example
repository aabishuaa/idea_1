# MyB AI service — copy to .env and fill in (see SETUP.md §2 and §7).

# Supabase (Project Settings → Data API / API Keys)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=REPLACE_ME
# service_role key — SERVER-SIDE ONLY, never in the app bundle (SR-13)
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# LLM providers (SR-11: Gemini primary → Groq failover)
GEMINI_API_KEY=REPLACE_ME
GROQ_API_KEY=REPLACE_ME

# Face match cosine-similarity threshold. Model-specific (ArcFace buffalo_l);
# a sensible demo value — calibrate false-accept/false-reject before production.
FACE_MATCH_THRESHOLD=0.35

# CORS origins for the Expo app (comma-separated; * is fine for the MVP demo)
CORS_ORIGINS=*
